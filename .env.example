NODE_ENV=production
PORT=5000
BASE_URL=https://impacthub.org

DATABASE_URL="postgresql://impactuser:impactpassword@localhost:5432/impacthub?schema=public"

JWT_ACCESS_SECRET="generate-with-crypto-randomBytes-32-hex-key"
JWT_REFRESH_SECRET="generate-with-crypto-randomBytes-32-hex-key"
COOKIE_SECRET="generate-with-crypto-randomBytes-32-hex-key"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=30

COOKIE_SECURE=true
COOKIE_SAME_SITE="lax"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
SMTP_FROM="ImpactHub <no-reply@impacthub.org>"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20

ADMIN_EMAILS="owner@impacthub.org,admin@impacthub.org"

SEED_DEMO_DATA=false
